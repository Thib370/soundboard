{
  "name": "soundboard-mic",
  "version": "0.1.0",
  "description": "Soundboard that plays into a virtual mic (Discord/Teams)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.soundboardmic",
    "files": [
      "*.js",
      "*.html",
      "*.css"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "playwright-core": "^1.65.1",
    "ws": "^8.23.0"
  }
}
